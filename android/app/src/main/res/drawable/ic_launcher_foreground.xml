<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground.
  Source: the double reticle `ic-double` in docs/06-name-and-icons.md, drawn directly on the
  108-unit adaptive icon grid. The realigned reticle stays inside the safe zone (radius 33); the
  ghost may reach past it, where the mask simply cuts it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Ghost: the whole reticle, shifted, as seen when the eye moves (parallax). -->
    <path
        android:pathData="M27,58a20,20 0 1,0 40,0a20,20 0 1,0 -40,0"
        android:strokeWidth="1.4"
        android:strokeColor="#F28C28"
        android:strokeAlpha="0.38"
        android:strokeLineCap="round" />
    <path
        android:pathData="M47,30V86M19,58H75"
        android:strokeWidth="1"
        android:strokeColor="#F28C28"
        android:strokeAlpha="0.38"
        android:strokeLineCap="round" />
    <!-- The reticle, realigned on the target. -->
    <path
        android:pathData="M34,54a20,20 0 1,0 40,0a20,20 0 1,0 -40,0"
        android:strokeWidth="2.4"
        android:strokeColor="#F28C28"
        android:strokeLineCap="round" />
    <path
        android:pathData="M54,26V82M26,54H82"
        android:strokeWidth="1.1"
        android:strokeColor="#E6EDF3"
        android:strokeLineCap="round" />
    <!-- Mil hash marks every 5 units. -->
    <path
        android:pathData="M39,52.4V55.6M52.4,39H55.6M44,52.4V55.6M52.4,44H55.6M49,52.4V55.6M52.4,49H55.6M59,52.4V55.6M52.4,59H55.6M64,52.4V55.6M52.4,64H55.6M69,52.4V55.6M52.4,69H55.6"
        android:strokeWidth="0.9"
        android:strokeColor="#E6EDF3"
        android:strokeLineCap="round" />
</vector>
